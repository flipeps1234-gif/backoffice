# Copy to .env.local (git-ignored) and fill in.

# Your OpenAI key. Server-side only — it is never sent to the browser.
OPENAI_API_KEY=

# Which OpenAI model reads the screenshots. Must support image input.
# Defaults to gpt-5.6. Cheaper vision-capable options: gpt-5.4-mini, gpt-5-mini.
# OPENAI_MODEL=gpt-5.6

# Force a provider. Without this we use openai when OPENAI_API_KEY is set,
# and the offline mock otherwise. Set to "mock" to develop without burning credits.
# EXTRACT_PROVIDER=mock

# Supabase — Dashboard → Project Settings → API.
# Both are public by design and safe in the browser: row level security is what
# protects the data, not the key. Leave blank to run in memory with no account.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for protected extraction quotas and founding signup (0022).
# Server-only: obtain from the project's API settings and set directly in
# Vercel's Production environment. Never NEXT_PUBLIC, never commit a value.
# Missing key or migration makes both paid uploads and signup fail closed.
SUPABASE_SERVICE_ROLE_KEY=

# The shared "tester" account. Server-side only — never NEXT_PUBLIC.
# Create this user in Supabase (Authentication → Users → Add user, with
# Auto Confirm) using an email whose local part is exactly "tester", e.g.
# tester@yourdomain.com. Typing the word "tester" on the sign-in screen
# signs into it via /api/demo-session; RLS keeps it away from real
# accounts' rows.
DEMO_EMAIL=
DEMO_PASSWORD=

# Tester uses the REAL extraction provider by default, with 10 images/day
# shared across all demo visitors (0022). Keep a provider-side spending cap
# too; image quotas are not exact dollar budgets. "mock" makes tester free.
# DEMO_EXTRACTION=mock

# ---- Notifications SPIKE (dark) — WhatsApp Cloud API ----
# All server-only. Leave EVERY one of these unset in production: the
# senders no-op unless WHATSAPP_ENABLED is exactly "true". Test creds
# (Meta's free test number) live in .env.local only.
# WHATSAPP_ENABLED=false
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Webhook writes also need SUPABASE_SERVICE_ROLE_KEY above AND the provider
# signing secret. Setting the service key alone never enables notifications.

# ---- Notifications SPIKE (dark) — Twilio SMS channel ----
# Same rules as WhatsApp: server-only, unset in production, senders
# no-op unless SMS_ENABLED is exactly "true".
# PRODUCTION BLOCKER: US A2P 10DLC registration required before real
# SMS traffic (see CLAUDE.md).
# SMS_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ---- Public website (landing, help, pricing, trade pages) ----
# All three optional, all NEXT_PUBLIC (inlined at build — set, then redeploy).
# Canonical origin for SEO: canonicals, sitemap, robots, share cards.
# Unset = https://getcontado.com (the live domain). Set only if it changes.
# NEXT_PUBLIC_SITE_URL=https://getcontado.com
# Google Analytics 4 measurement ID. Public pages only — never /app, and
# Do Not Track is honored. Unset = the committed default G-JEM7B09P0L
# (measurement IDs are public). Empty string = analytics off.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-JEM7B09P0L
# Shown on the contact page and footer as a mailto link when set.
# NEXT_PUBLIC_SUPPORT_EMAIL=
